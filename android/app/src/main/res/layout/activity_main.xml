<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="24dp"
        android:paddingRight="18dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/navy"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subtitle"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/vpnStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/status_background"
            android:text="正在检查 VPN…"
            android:textColor="@color/navy"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tailscaleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/connect_tailscale" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connection_title"
                android:textColor="@color/navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/hostInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/host_hint"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />

            <EditText
                android:id="@+id/portInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/port_hint"
                android:inputType="number"
                android:singleLine="true" />

            <EditText
                android:id="@+id/userInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/user_hint"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />

            <EditText
                android:id="@+id/tailnetBaseInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tailscale Serve 根地址（https://电脑.ts.net）"
                android:inputType="textUri"
                android:singleLine="true" />

            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/password_hint"
                android:importantForAutofill="noExcludeDescendants"
                android:inputType="textPassword"
                android:saveEnabled="false"
                android:singleLine="true" />

            <Button
                android:id="@+id/unlockButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/blue"
                android:text="@string/unlock"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/lockButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/lock"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mobileUrlText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/control_title"
                android:textColor="@color/navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dshStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="未连接"
                android:textColor="@color/muted"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/startButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/green"
                    android:enabled="false"
                    android:text="@string/start"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/statusButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/blue"
                    android:enabled="false"
                    android:text="@string/status"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/stopButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/red"
                    android:enabled="false"
                    android:text="@string/stop"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical">

            <TextView
                android:id="@+id/desktopUrlText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/links_title"
                android:textColor="@color/navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:autoLink="web"
                android:text="https://computer.example.ts.net/m"
                android:textColor="@color/blue"
                android:textIsSelectable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:autoLink="web"
                android:text="https://computer.example.ts.net/"
                android:textColor="@color/blue"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/mobileWebButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/blue"
                android:text="@string/open_mobile"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/desktopWebButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/open_desktop" />

            <Button
                android:id="@+id/copyLinksButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/copy_links" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_title"
                android:textColor="@color/navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="等待操作。"
                android:textColor="@color/navy"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <Button
                android:id="@+id/resetHostKeyButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/reset_host_key" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/security_note"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
